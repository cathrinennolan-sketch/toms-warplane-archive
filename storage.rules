rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for all stored files (photos, portraits, PDFs)
    match /{allPaths=**} {
      allow read: if true;
      // Only authenticated admin users may write
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}
